# Copy this file to .env (or .env.local) and adjust for local development.
# Vite only exposes variables prefixed VITE_ to client code — see Frontend/lib/env.ts.
# Never commit real .env files (see .gitignore).

# Base URL of the NeuroCool backend's REST API (see backend/app/main.py).
VITE_API_URL=http://localhost:8000

# Base URL of the backend's WebSocket endpoint (see backend/app/websocket).
# If omitted, it is derived from VITE_API_URL (http->ws, https->wss).
VITE_WS_URL=ws://localhost:8000
