# Copy this file to .env and adjust values for local development.
# docker-compose.yml already ships with safe defaults, so `docker compose up`
# works without this file — use it to override anything (especially
# POSTGRES_PASSWORD) for a real deployment.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO
PROJECT_NAME="NeuroCool Backend"

# --- CORS (comma-separated origins) ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PostgreSQL ---
POSTGRES_USER=neurocool
POSTGRES_PASSWORD=change-me
POSTGRES_DB=neurocool
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- NeuroCore AI (optional) ---
# Without a matching API key, /api/ai/chat reports a clear "unavailable"
# response — the rest of the backend works exactly the same either way.
# Never commit real keys here; this file documents variable names only.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RESPONSE_TOKENS=800
