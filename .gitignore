# Dependencies
node_modules/

# Production build
dist/
build/

# Environment variables
.env
.env.*
!.env.example
# (.env.example is intentionally NOT ignored — it's committed documentation)

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.orig
*.rej

# Local agent/editor tool settings (machine-specific, not shared)
.claude/

# OS
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# TypeScript
*.tsbuildinfo

# Vite
.vite/

# Coverage
coverage/

# Cache
.cache/
.eslintcache

# Temporary files
*.tmp
*.temp

# Optional lockfiles (keep only the one you use)
# yarn.lock
# pnpm-lock.yaml

# If using npm, DO NOT ignore package-lock.json

# --- Backend (Python) ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
.hypothesis/
htmlcov/
.venv/
venv/
.python-version

# Local databases / dumps
*.sqlite3
*.db
*.sql.gz

# Backend local database/cache volumes (only relevant if bind-mounted;
# the default docker-compose.yml uses named Docker volumes instead)
postgres_data/
redis_data/